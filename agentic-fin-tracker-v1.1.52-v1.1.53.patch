+    let code = 0, first = 0, index = 0;
+    for (let len = 1; len < 16; len++) {
+      code |= bits(1);
+      const count = t.counts[len];
+      if (code - count < first) return t.symbols[index + (code - first)];
+      index += count; first += count; first <<= 1; code <<= 1;
